{
  "name": "karaokedock-mobile",
  "private": true,
  "version": "0.5.0-beta",
  "scripts": {
    "build:web": "pnpm --dir ../../web build:mobile",
    "sync": "pnpm build:web && node ../sync-android.mjs mobile",
    "apk:debug": "pnpm sync && cd android && ./gradlew assembleDebug",
    "apk:release": "pnpm sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
